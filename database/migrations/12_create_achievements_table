--This table shows what each experience has helped me to achieve. All should have impact and metrics so that the created resume can follow the Google xyz method
CREATE TABLE achievements (

  achievement_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,

  experience_id BIGINT NOT NULL,

  impact TEXT NOT NULL,

  metrics TEXT NOT NULL,

  category TEXT NOT NULL,

CONSTRAINT experience_id_foreign_key 
  FOREIGN KEY (experience_id)
  REFERENCES experiences(experience_id)
)
